# Copy to .env.local and fill in real values. Never commit .env.local.
# See .agents/rules/security.md's Secrets and Configuration section.

DATABASE_URL=                  # Neon Postgres connection string (via the Vercel Marketplace integration)
ANTHROPIC_API_KEY=             # Claude API key
AUTH_SECRET=                   # Auth.js session/JWT signing secret — generate with: npx auth secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
BLOB_READ_WRITE_TOKEN=         # Vercel Blob token, for uploaded CSV files

# Optional — production rate-limiter backing store (Upstash Redis via the
# Vercel Marketplace integration). Leave unset for local development: lib/
# rate-limit.ts falls back to an in-memory limiter when these are missing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
